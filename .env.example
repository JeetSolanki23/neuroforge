# NeuroForge — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to Git

# =============================================================================
# LLM Provider
# =============================================================================

# Your API key for the active provider
# Anthropic key → https://console.anthropic.com
# OpenAI key    → https://platform.openai.com
# For openai-compatible local models (e.g. Ollama) any non-empty string works
NEUROFORGE_API_KEY=your_api_key_here

# Provider to use: anthropic | openai | openai-compatible
NEUROFORGE_PROVIDER=anthropic

# Model name — must match the chosen provider
# Anthropic:          claude-sonnet-4-6
# OpenAI:             gpt-4o
# Ollama (local):     llama3.1:70b
NEUROFORGE_MODEL=claude-sonnet-4-6

# Base URL — only required for openai-compatible provider
# Ollama:   http://localhost:11434/v1
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
NEUROFORGE_BASE_URL=

# Max tokens per agent LLM call
NEUROFORGE_MAX_TOKENS=4096

# =============================================================================
# Memory
# =============================================================================

# Path where ChromaDB persists data (relative to project root)
CHROMA_PERSIST_PATH=./neuroforge-memory

# Path to the runtime memory vault markdown files (relative to project root)
MEMORY_VAULT_PATH=./memory-vault

# =============================================================================
# Agent Behaviour
# =============================================================================

# Max parallel instances per agent type (Resource Manager limit)
MAX_INSTANCES_PER_AGENT_TYPE=3

# Number of logged decisions that triggers a mid-project memory report
MEMORY_REPORT_THRESHOLD=50

# Max retry attempts per task before escalating to next failure layer
MAX_TASK_RETRIES=3

# =============================================================================
# Logging
# =============================================================================

# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
